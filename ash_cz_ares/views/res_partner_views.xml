<odoo>
    <record id="view_partner_form_ares" model="ir.ui.view">
        <field name="name">res.partner.form.ares</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//widget[@name='web_ribbon']" position="after">
                <!-- Shifted down so it does not overlap the Archived ribbon -->
                <widget name="web_ribbon" title="UNRELIABLE"
                    bg_color="text-bg-danger"
                    invisible="is_unreliable_payer != 'unreliable'"
                    style="padding-top: 60px !important;"/>
            </xpath>
            <xpath expr="//field[@name='website']" position="before">
                <label for="is_unreliable_payer"/>
                <div class="o_row">
                    <field name="is_unreliable_payer" widget="badge"
                        decoration-danger="is_unreliable_payer == 'unreliable'"
                        decoration-success="is_unreliable_payer == 'reliable'"
                        decoration-warning="is_unreliable_payer == 'not_vat_payer'"/>
                    <button name="action_check_unreliable_vat_payer" type="object"
                        string="Verify VAT Payer" class="btn-link" icon="fa-refresh"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_partner_form_ares_company_registry" model="ir.ui.view">
        <field name="name">res.partner.form.ares.company.registry</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="l10n_cz.res_partner_view_form_inherit_l10n_cz"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_registry'][not(ancestor::page)]" position="attributes">
                <attribute name="widget">ares_company_registry</attribute>
                <attribute name="invisible">country_code and country_code != 'CZ'</attribute>
            </xpath>
        </field>
    </record>

    <record id="action_server_batch_vat_check" model="ir.actions.server">
        <field name="name">Check VAT Payer Reliability (MFČR)</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_check_unreliable_vat_payer()</field>
    </record>
</odoo>
