<odoo>
    <record id="view_partner_form_ares" model="ir.ui.view">
        <field name="name">res.partner.form.ares</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//widget[@name='web_ribbon']" position="after">
                <widget name="web_ribbon" title="NESPOLEHLIVÝ" 
                    bg_color="bg-danger"
                    invisible="is_unreliable_payer != 'unreliable'"
                    style="padding-top: 60px !important;"/>
            </xpath>

            <xpath expr="//field[@name='website']" position="before">
                
                <field name="is_unreliable_payer" invisible="1"/>
                
                
                <!-- label for="action_check_unreliable_vat_payer" string="VAT Status"/ -->
                <div class="o_cell o_wrap_label text-break text-900">
                    <label class="o_form_label" for="action_check_unreliable_vat_payer" string="VAT Status"/>
                </div>
            <div class="o_cell o_wrap_input text-break mb-3 mb-sm-0" style="">
                <div name="is_unreliable_payer" class="o_field_widget o_field_char">
                    
                    <span invisible="is_unreliable_payer != 'unreliable'" class="text-danger fw-bold ms-2">
                        <i class="fa fa-exclamation-triangle"/> Unreliable Payer
                    </span>

                    <span invisible="is_unreliable_payer != 'reliable'" class="text-success ms-2">
                        <i class="fa fa-check-circle"/> Reliable Payer
                    </span>

                    <span invisible="is_unreliable_payer != 'not_checked'" class="text-muted ms-2 italic">
                        <i class="fa fa-question-circle"/> Not Checked
                    </span>

                    <button name="action_check_unreliable_vat_payer" type="object" 
                            string="Check in ARES" 
                            class="btn-link" 
                            icon="fa-refresh"/>
                </div>
            </div>
            </xpath>
        </field>
    </record>

    <record id="action_server_batch_vat_check" model="ir.actions.server">
        <field name="name">Check ARES Reliability (Batch)</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">list</field> <field name="state">code</field>
        <field name="code">
# 'records' is a special Odoo variable containing all selected rows
for record in records:
    record.action_check_unreliable_vat_payer()
        </field>
    </record>
</odoo>
