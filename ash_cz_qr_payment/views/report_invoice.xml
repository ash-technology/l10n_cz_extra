<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document" inherit_id="account.report_invoice_document">
        <!-- Czech accounts: the national account number, the IBAN on its own line -->
        <xpath expr="//p[@name='payment_communication']/t/span[@t-field='o.partner_bank_id']" position="attributes">
            <attribute name="t-if">not o.partner_bank_id._get_cz_acc_number()</attribute>
        </xpath>
        <xpath expr="//p[@name='payment_communication']/t/span[@t-field='o.partner_bank_id']" position="after">
            <t t-else="">
                <span class="fw-bold"><span class="text-nowrap" t-out="o.partner_bank_id._get_cz_acc_number()"/><t t-if="o.partner_bank_id.bank_id"> - <t t-out="o.partner_bank_id.bank_id.name"/></t></span>
                <br/>IBAN: <span class="fw-bold text-nowrap" t-field="o.partner_bank_id.acc_number"/>
            </t>
        </xpath>
    </template>
</odoo>
